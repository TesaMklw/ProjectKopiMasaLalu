<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="main.java.controller.PilihInterfaceController"
           stylesheets="@css/style.css" prefWidth="480" prefHeight="460">
    <VBox alignment="CENTER" spacing="14" maxWidth="360" styleClass="card">
        <Label fx:id="lblJudul" text="KOPI MASA LALU" styleClass="brand"/>
        <Label text="Pilih tampilan yang ingin dibuka" styleClass="subtitle"/>
        <Button text="Pelanggan" onAction="#bukaPelanggan" maxWidth="Infinity" styleClass="tile"
                style="-fx-font-size: 14px; -fx-padding: 8 14 8 14; -fx-min-height: 36; -fx-pref-height: 36; -fx-max-height: 36; -fx-background-radius: 8; -fx-border-radius: 8;"/>
        <Button text="Gerai" onAction="#bukaGerai" maxWidth="Infinity" styleClass="tile secondary"
                style="-fx-font-size: 14px; -fx-padding: 8 14 8 14; -fx-min-height: 36; -fx-pref-height: 36; -fx-max-height: 36; -fx-background-radius: 8; -fx-border-radius: 8;"/>
        <Button text="Keluar Program" onAction="#keluarProgram" maxWidth="Infinity" styleClass="ghost"/>
        <Label text="Pelanggan dan gerai terbuka di jendela baru. Keluar program hanya dari layar ini."
               styleClass="hint" wrapText="true"/>
        <padding>
            <Insets top="8" right="8" bottom="8" left="8"/>
        </padding>
    </VBox>
</StackPane>
