<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.PembayaranTableController"
      stylesheets="@css/style.css" spacing="12" styleClass="page"
      prefWidth="760" prefHeight="560">
    <Label text="Metode Pembayaran" styleClass="page-title"/>
    <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colKode" text="Kode" prefWidth="140"/>
            <TableColumn fx:id="colMetode" text="Metode" prefWidth="320"/>
        </columns>
        <placeholder>
            <Label text="Belum ada metode pembayaran."/>
        </placeholder>
    </TableView>
    <GridPane hgap="8" vgap="8" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Kode" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtKode" promptText="CASH" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Metode" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMetode" promptText="Cash" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="8">
        <Button text="Tambah" onAction="#tambah"/>
        <Button text="Ubah" onAction="#ubah" styleClass="secondary"/>
        <Button text="Hapus" onAction="#hapus" styleClass="ghost"/>
        <Button text="Bersihkan" onAction="#bersih" styleClass="ghost"/>
        <Button text="Muat ulang" onAction="#muat" styleClass="secondary"/>
    </HBox>
</VBox>
