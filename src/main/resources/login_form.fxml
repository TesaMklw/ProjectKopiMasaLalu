<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="main.java.controller.LoginController"
           stylesheets="@css/style.css" prefWidth="520" prefHeight="620">
    <fx:define>
        <ToggleGroup fx:id="modeLogin"/>
    </fx:define>
    <VBox alignment="CENTER" spacing="10" maxWidth="400" styleClass="card">
        <Label text="KOPI KENANGAN" styleClass="brand"/>
        <Label fx:id="lblSubtitle" text="Pilih cara masuk" styleClass="subtitle"/>

        <HBox spacing="8" alignment="CENTER" styleClass="mode-row">
            <ToggleButton fx:id="btnModePelanggan" text="Masuk sebagai Pelanggan"
                          toggleGroup="$modeLogin" selected="true"
                          onAction="#pilihModePelanggan" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                          styleClass="mode-btn"/>
            <ToggleButton fx:id="btnModeGerai" text="Masuk sebagai Gerai"
                          toggleGroup="$modeLogin"
                          onAction="#pilihModeGerai" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                          styleClass="mode-btn"/>
        </HBox>

        <VBox fx:id="panelPelanggan" spacing="10">
            <Label text="Nama pelanggan"/>
            <TextField fx:id="txtNama" promptText="contoh: Vionanda"/>
            <Label text="Password"/>
            <PasswordField fx:id="txtPassword" promptText="password" onAction="#masuk"/>
            <Label text="No HP (untuk daftar)"/>
            <TextField fx:id="txtNoHp" promptText="08xxxxxxxxxx"/>
        </VBox>

        <VBox fx:id="panelGerai" spacing="10" managed="false" visible="false">
            <Label text="Kode gerai"/>
            <TextField fx:id="txtKodeGerai" promptText="contoh: GR01" onAction="#masuk"/>
            <Label text="Nama gerai"/>
            <TextField fx:id="txtNamaGerai" promptText="sesuai data gerai" onAction="#masuk"/>
        </VBox>

        <Label fx:id="lblPesan" styleClass="error" wrapText="true"/>
        <HBox spacing="8" alignment="CENTER">
            <Button text="Masuk" onAction="#masuk" defaultButton="true"/>
            <Button fx:id="btnDaftar" text="Daftar" onAction="#daftar" styleClass="secondary"/>
            <Button text="Keluar" onAction="#keluar" styleClass="ghost"/>
        </HBox>
        <Label fx:id="lblHint"
               text="Pelanggan: nama + password dari tabel pelanggan. Bisa daftar akun baru."
               styleClass="hint" wrapText="true"/>
        <padding>
            <Insets top="8" right="8" bottom="8" left="8"/>
        </padding>
    </VBox>
</StackPane>
