<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="main.java.controller.LoginController"
           stylesheets="@css/style.css" prefWidth="480" prefHeight="560">
    <fx:define>
        <ToggleGroup fx:id="modeAkun"/>
    </fx:define>
    <VBox alignment="CENTER" spacing="10" maxWidth="380" styleClass="card">
        <Label text="KOPI KENANGAN" styleClass="brand"/>
        <Label fx:id="lblSubtitle" text="Masuk sebagai pelanggan" styleClass="subtitle"/>

        <HBox fx:id="barisAkun" spacing="8" alignment="CENTER" styleClass="mode-row">
            <ToggleButton fx:id="btnModeMasuk" text="Sign in" toggleGroup="$modeAkun" selected="true"
                          onAction="#tampilkanMasuk" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                          styleClass="mode-btn"/>
            <ToggleButton fx:id="btnModeDaftar" text="Sign up" toggleGroup="$modeAkun"
                          onAction="#tampilkanDaftar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                          styleClass="mode-btn"/>
        </HBox>

        <VBox fx:id="panelPelanggan" spacing="10">
            <Label text="Nama pelanggan"/>
            <TextField fx:id="txtNama" promptText="contoh: Vionanda"/>
            <Label text="Password"/>
            <PasswordField fx:id="txtPassword" promptText="password" onAction="#tekanEnterPelanggan"/>
            <VBox fx:id="panelNoHp" spacing="10" managed="false" visible="false">
                <Label text="No HP"/>
                <TextField fx:id="txtNoHp" promptText="08xxxxxxxxxx" onAction="#signup"/>
            </VBox>
        </VBox>

        <VBox fx:id="panelGerai" spacing="10" managed="false" visible="false">
            <Label text="Kode gerai"/>
            <TextField fx:id="txtKodeGerai" promptText="contoh: GR01" onAction="#signin"/>
            <Label text="Nama gerai"/>
            <TextField fx:id="txtNamaGerai" promptText="sesuai data gerai" onAction="#signin"/>
        </VBox>

        <Label fx:id="lblPesan" styleClass="error" wrapText="true"/>
        <HBox spacing="8" alignment="CENTER">
            <Button fx:id="btnMasuk" text="Masuk" onAction="#signin" defaultButton="true"/>
            <Button fx:id="btnDaftar" text="Daftar" onAction="#signup" styleClass="secondary"
                    managed="false" visible="false"/>
            <Button text="Tutup" onAction="#tutup" styleClass="ghost"/>
        </HBox>
        <Label fx:id="lblHint"
               text="Masuk dengan nama dan password. No HP hanya diisi saat sign up."
               styleClass="hint" wrapText="true"/>
        <padding>
            <Insets top="8" right="8" bottom="8" left="8"/>
        </padding>
    </VBox>
</StackPane>
