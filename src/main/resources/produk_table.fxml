<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.ProdukTableController"
      stylesheets="@css/style.css" spacing="12" styleClass="page"
      prefWidth="1100" prefHeight="700">
    <Label text="Katalog Produk" styleClass="page-title"/>
    <Label text="Hierarki: Produk → Minuman → Kopi / BukanKopi, dan Produk → MakananPenutup. Diskon makanan penutup maksimal 20%. Minuman: isi harga untuk ukuran yang dijual, kosongkan ukuran yang tidak dijual." styleClass="hint" wrapText="true"/>
    <GridPane hgap="8" vgap="8" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="220"/>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="220"/>
        </columnConstraints>
        <Label text="Tipe" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipe" maxWidth="Infinity" promptText="Kopi" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Nama" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtNama" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label fx:id="lblHarga" text="Harga" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtHarga" promptText="18000" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="lblUkuran" text="Harga per ukuran" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <HBox fx:id="boxUkuran" spacing="6" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="3">
            <Label text="S" minWidth="12"/>
            <TextField fx:id="txtHargaSmall" promptText="Small" HBox.hgrow="ALWAYS"/>
            <Label text="M" minWidth="14"/>
            <TextField fx:id="txtHargaMedium" promptText="Medium" HBox.hgrow="ALWAYS"/>
            <Label text="L" minWidth="10"/>
            <TextField fx:id="txtHargaLarge" promptText="Large" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Label fx:id="lblInfo" text="Jenis / variasi" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbInfo" maxWidth="Infinity" promptText="Pilih sesuai kategori" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="8">
        <Button text="Tambah" onAction="#tambah"/>
        <Button text="Ubah" onAction="#ubah" styleClass="secondary"/>
        <Button text="Hapus" onAction="#hapus" styleClass="ghost"/>
        <Button text="Bersihkan" onAction="#bersih" styleClass="ghost"/>
        <Button text="Muat ulang" onAction="#muat" styleClass="secondary"/>
    </HBox>
    <TableView fx:id="tabel" VBox.vgrow="ALWAYS" minHeight="220">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTipe" text="Tipe" prefWidth="130"/>
            <TableColumn fx:id="colNama" text="Nama" prefWidth="200"/>
            <TableColumn fx:id="colHarga" text="Harga mulai" prefWidth="100"/>
            <TableColumn fx:id="colUkuran" text="Ukuran dan harga" prefWidth="260"/>
            <TableColumn fx:id="colInfo" text="Jenis / variasi" prefWidth="160"/>
        </columns>
        <placeholder>
            <Label text="Belum ada produk."/>
        </placeholder>
    </TableView>
</VBox>
